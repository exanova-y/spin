---
layout: layouts/base.njk
bodyClass: page-forest
---
{% from "forest-tree.njk" import tree, toc %}
{% set node = content | forestTree({
  noteId: noteId,
  title: title,
  date: date,
  author: author or "Yoyo",
  tags: tags,
  category: category,
  taxon: taxon
}, page.url) %}

<header class="forest-header">
  <a class="link local" href="/writing/">« Writing</a>
</header>

<div id="grid-wrapper">
  <article id="content" class="markdown-content">
    {{ tree(node) }}

    {#- Precomputed embedding matches (related.json) win; TF-IDF is the fallback. -#}
    {% set rel = related[page.url] if related else null %}
    {% if not rel %}{% set rel = curius | relatedBookmarks(title, tags, content, 5) %}{% endif %}
    {% if rel.length %}
    <footer>
      <section class="block link-list hide-metadata">
        <details id="{{ node.anchor }}-related" open>
          <summary>
            <header><h1>Related links from Yoyo's bookshelf</h1></header>
          </summary>
          <div class="tree-content">
            <ul>
              {% for b in rel %}
              <li><a class="link external" href="{{ b.link }}" target="_blank" rel="noopener">{{ b.title }}</a>
                {%- if b.snippet %}<br><span class="link-snippet">{{ b.snippet | truncate(120) }}</span>{% endif %}
              </li>
              {% endfor %}
            </ul>
          </div>
        </details>
      </section>
    </footer>
    {% endif %}
  </article>

  {% if node.children.length %}
  <nav id="toc" aria-label="Table of contents">
    <div class="block">
      <h1>Table of Contents</h1>
      {{ toc(node.children) }}
    </div>
  </nav>
  {% endif %}
</div>

<script src="/js/forest.js" defer></script>
