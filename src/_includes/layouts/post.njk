---
layout: layouts/base.njk
---
<div id="content" class="markdown-content">
  <h3 class="post-title">{{ title }}{% if noteId %} <a class="note-address" href="{{ page.url }}">[{{ noteId }}]</a>{% endif %}</h3>
  {% if date %}
  <p class="post-meta">
    <em>by <span class="post-author">{{ author or "Yoyo" }}</span> • <span class="post-date">{{ date | formatDate }}</span></em>
    {% if tags %}
      {% for tag in tags %}
        {% if tag != "pages" and tag != "favs" %}
          <a href="/tags/{{ tag | slugify }}/" class="post-tag">#{{ tag }}</a>
        {% endif %}
      {% endfor %}
    {% endif %}
  </p>
  {% endif %}
  <br>
  {{ content | safe }}

{# Prefer precomputed embedding matches (related.json); fall back to build-time TF-IDF #}
{% set rel = related[page.url] if related else null %}
{% if not rel %}
  {% set rel = curius | relatedBookmarks(title, tags, content, 5) %}
{% endif %}
{% if rel.length %}
<br>
<h4>Related links from Yoyo's bookshelf</h4>
<ul>
{% for b in rel %}
  <li><a href="{{ b.link }}" target="_blank" rel="noopener">{{ b.title }}</a>{% if b.snippet %}<br><span style="opacity: 0.6; font-size: 0.85em;">{{ b.snippet | truncate(120) }}</span>{% endif %}</li>
{% endfor %}
</ul>
{% endif %}
</div>
<div class="post-navigation">
  <a href="/writing" class="back-link">← Back to writing</a>
</div>

{% if content | containsMath %}<script>
  document.addEventListener('DOMContentLoaded', function() {
    const content = document.getElementById('content');
    if (typeof renderMathInElement === 'function') {
      renderMathInElement(content, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$',  right: '$',  display: false }
        ],
        throwOnError: false
      });
    }
  });
</script>{% endif %}
