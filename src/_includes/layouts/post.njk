---
layout: layouts/base.njk
---
<div id="content" class="markdown-content">
  <h3>{{ title }}</h3>
  {% if date %}
  <p>
    <em>by {{ author or "Yoyo" }} • {{ date | formatDate }}</em>
    {% if tags %}
      {% for tag in tags %}
        {% if tag != "pages" and tag != "favs" %}
          <a href="/tags/{{ tag | slugify }}/" class="post-tag" style="font-size: 0.8em; opacity: 0.7; border: 1px solid #bcc0cc; border-radius: 0px; padding: 2px 6px; margin-left: 8px; font-family: monospace; text-decoration: none; color: inherit;">#{{ tag }}</a>
        {% endif %}
      {% endfor %}
    {% endif %}
  </p>
  {% endif %}
  <br>
  {{ content | safe }}

{% set related = curius | relatedBookmarks(title, tags, content, 5) %}
{% if related.length %}
<br>
<h4>similar links from Yoyo's bookshelf</h4>
<ul>
{% for b in related %}
  <li><a href="{{ b.link }}" target="_blank" rel="noopener">{{ b.title }}</a>{% if b.snippet %}<br><span style="opacity: 0.6; font-size: 0.85em;">{{ b.snippet | truncate(120) }}</span>{% endif %}</li>
{% endfor %}
</ul>
{% endif %}
</div>
<div class="post-navigation">
  <a href="/writing" class="back-link">← Back to writing</a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const content = document.getElementById('content');
    if (typeof renderMathInElement === 'function') {
      renderMathInElement(content, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$',  right: '$',  display: false }
        ],
        throwOnError: false
      });
    }
  });
</script>
